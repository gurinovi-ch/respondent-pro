+
+/**
+ * ╨Я╤А╨╕╤С╨╝ alarm'╨╛╨▓ ╤Б╤В╤А╨░╨╢╨░ ╨╕ ╤А╨░╨╖╨╛╨▓╨╛╨│╨╛ ╨┐╨╡╤А╨╡╨╖╨░╨┐╤Г╤Б╨║╨░ (spec ┬з3).
+ * ACTION_WATCHDOG тАФ ╨▓╤Б╨╡╨│╨┤╨░ ╨┐╨╡╤А╨╡╨┐╨╗╨░╨╜╨╕╤А╤Г╨╡╤В ╤Б╨╗╨╡╨┤╤Г╤О╤Й╨╕╨╣ ╤И╨░╨│ (╤Ж╨╡╨┐╨╛╤З╨║╨░ ╨╜╨╡ ╤А╨▓╤С╤В╤Б╤П),
+ * ╨╕ ╨┐╨╡╤А╨╡╨╖╨░╨┐╤Г╤Б╨║╨░╨╡╤В ╨┐╤А╨╕╨╗╨╛╨╢╨╡╨╜╨╕╨╡, ╨╡╤Б╨╗╨╕ ╨╛╨╜╨╛ ╨▓ ╤Д╨╛╨╜╨╡ ╨╕ ╨╜╨╡ ╨╕╨┤╤С╤В excursion.
+ */
+class RestartReceiver : BroadcastReceiver() {
+
+    companion object {
+        private const val TAG = "RestartReceiver"
+    }
+
+    override fun onReceive(context: Context, intent: Intent) {
+        when (intent.action) {
+            WatchdogScheduler.ACTION_WATCHDOG -> {
+                WatchdogScheduler.scheduleNext(context)
+                maybeRestart(context)
