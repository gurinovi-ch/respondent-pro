<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:minHeight="@dimen/kb_max_height"
    android:padding="@dimen/kb_general_padding"
    android:background="#F5F5F5">

    <LinearLayout
        android:id="@+id/english_keyboard"
        android:visibility="gone"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="@dimen/kb_row_height">
            <Button
                android:id="@+id/t_eng_q"
                style="@style/keyboard_text_button"
                android:text="q"/>
            <Button
                android:id="@+id/t_eng_w"
                style="@style/keyboard_text_button"
                android:text="w"/>
            <Button
                android:id="@+id/t_eng_e"
                style="@style/keyboard_text_button"
                android:text="e"/>
            <Button
                android:id="@+id/t_eng_r"
                style="@style/keyboard_text_button"
                android:text="r"/>
            <Button
                android:id="@+id/t_eng_t"
                style="@style/keyboard_text_button"
                android:text="t"/>
            <Button
                android:id="@+id/t_eng_y"
                style="@style/keyboard_text_button"
                android:text="y"/>
            <Button
                android:id="@+id/t_eng_u"
                style="@style/keyboard_text_button"
                android:text="u"/>
            <Button
                android:id="@+id/t_eng_i"
                style="@style/keyboard_text_button"
                android:text="i"/>
            <Button
                android:id="@+id/t_eng_o"
                style="@style/keyboard_text_button"
                android:text="o"/>
