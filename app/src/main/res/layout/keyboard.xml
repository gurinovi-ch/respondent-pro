                style="@style/keyboard_text_button"
                android:text="p"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="@dimen/kb_row_height">
            <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.5"/>
            <Button
                android:id="@+id/t_eng_a"
                style="@style/keyboard_text_button"
                android:text="a"/>
            <Button
                android:id="@+id/t_eng_s"
                style="@style/keyboard_text_button"
                android:text="s"/>
            <Button
                android:id="@+id/t_eng_d"
                style="@style/keyboard_text_button"
                android:text="d"/>
            <Button
                android:id="@+id/t_eng_f"
                style="@style/keyboard_text_button"
                android:text="f"/>
            <Button
                android:id="@+id/t_eng_g"
                style="@style/keyboard_text_button"
                android:text="g"/>
            <Button
                android:id="@+id/t_eng_h"
                style="@style/keyboard_text_button"
                android:text="h"/>
            <Button
                android:id="@+id/t_eng_j"
                style="@style/keyboard_text_button"
                android:text="j"/>
            <Button
                android:id="@+id/t_eng_k"
                style="@style/keyboard_text_button"
                android:text="k"/>
            <Button
                android:id="@+id/t_eng_l"
                style="@style/keyboard_text_button"
                android:text="l"/>
            <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.5"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="@dimen/kb_row_height">
            <Button
                android:id="@+id/t_eng_shift"
                style="@style/keyboard_system_button"
                android:layout_weight="1.5"
                android:text="⇧"/>
            <Button
                android:id="@+id/t_eng_z"
                style="@style/keyboard_text_button"
                android:text="z"/>
            <Button
                android:id="@+id/t_eng_x"
                style="@style/keyboard_text_button"
                android:text="x"/>
            <Button
                android:id="@+id/t_eng_c"
                style="@style/keyboard_text_button"
                android:text="c"/>
            <Button
                android:id="@+id/t_eng_v"
                style="@style/keyboard_text_button"
                android:text="v"/>
            <Button
                android:id="@+id/t_eng_b"
                style="@style/keyboard_text_button"
                android:text="b"/>
            <Button
                android:id="@+id/t_eng_n"
                style="@style/keyboard_text_button"
                android:text="n"/>
            <Button
                android:id="@+id/t_eng_m"
                style="@style/keyboard_text_button"
                android:text="m"/>

            <Button
                android:id="@+id/t_eng_backspace"
                style="@style/keyboard_system_button"
                android:layout_weight="1.5"
                android:text="⌫"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="@dimen/kb_row_height">
            <Button
                android:id="@+id/t_eng_123"
                style="@style/keyboard_system_button"
                android:layout_weight="1.5"
                android:text="123@"/>
            <Button
                android:id="@+id/t_eng_lang"
                style="@style/keyboard_system_button"
                android:text="Ru/En"
                android:textSize="@dimen/kb_btn_lang_size"
                android:layout_weight="1"/>
            <Button
                android:id="@+id/t_eng_comma"
                style="@style/keyboard_text_button"
                android:text=","/>
            <Button
                android:id="@+id/t_eng_space"
                style="@style/keyboard_text_button"
                android:text=" "
                android:drawableBottom="@drawable/ic_keyboard_space"
                android:layout_weight="3.15"/>
            <Button
                android:id="@+id/t_eng_dot"
                style="@style/keyboard_text_button"
                android:text="."/>
            <Button
                android:id="@+id/t_eng_at"
                style="@style/keyboard_text_button"
                android:text="\@"/>
            <Button
                android:id="@+id/t_eng_enter"
                style="@style/keyboard_system_button"
                android:layout_weight="1.5"
                android:text="↵"/>
        </LinearLayout>
    </LinearLayout>

